# Локальные настройки разработчика.
# Скопируйте этот файл в .env (рядом с manage.py) и раскомментируйте нужные строки.
# Файл .env не коммитится. Переменные, уже заданные в окружении, имеют приоритет над ним.
# На сервере эти же переменные задаются в /etc/physicschool.env (см. deploy/DEPLOY.md).

# Секретный ключ. Локально можно не задавать, тогда используется ключ для разработки.
# DJANGO_SECRET_KEY=

# 1 = режим отладки (по умолчанию), 0 = как на сервере.
# DJANGO_DEBUG=1

# Хосты через запятую. При DEBUG=1 и пустом списке Django сам разрешает localhost/127.0.0.1.
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Origin'ы со схемой, через запятую. Нужны, только если открываете сайт не через localhost.
# DJANGO_CSRF_TRUSTED_ORIGINS=http://192.168.1.10:8000

# Путь к своей базе SQLite. По умолчанию PhysicSchool/db.sqlite3.
# DJANGO_DB_PATH=C:\path\to\my.sqlite3
